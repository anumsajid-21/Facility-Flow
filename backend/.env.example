# FacilityFlow backend environment (development)
# Copy to .env and adjust values for your environment.
# Never commit real secrets.

# PostgreSQL connection string (Docker Compose default user/password).
# When running the embedded dev database (scripts/dev-db.mjs) authentication uses trust
# so the password value is ignored locally.
DATABASE_URL="postgresql://postgres:password@localhost:5432/facilityflow?schema=public"

# JWT signing secret (REQUIRED to change before public launch).
JWT_SECRET="super-secret-jwt-key-facilityflow-12345"
JWT_EXPIRES_IN="1d"

# HTTP server
PORT=3001

# Allowed frontend origins for CORS (comma-separated).
CORS_ORIGIN="http://localhost:3000"

# Local file storage root (used when no S3-compatible storage is configured).
UPLOAD_ROOT="./uploads"
# Optional S3-compatible object storage (leave empty to use local storage).
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# Email provider: "console" (log only) or "smtp".
EMAIL_PROVIDER="console"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM="FacilityFlow <no-reply@facilityflow.app>"

# Absolute URL of frontend used in generated links (password reset, notifications, public asset links).
FRONTEND_URL="http://localhost:3000"

# AI Assist for Service Requests (optional — feature is hidden/disabled if no key is set).
# Free-tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"