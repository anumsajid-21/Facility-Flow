{
  "name": "backend",
  "version": "0.0.1",
  "description": "FacilityFlow backend API",
  "author": "FacilityFlow",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:start": "node scripts/dev-db.mjs start",
    "db:stop": "node scripts/dev-db.mjs stop",
    "db:status": "node scripts/dev-db.mjs status",
    "db:create": "node scripts/dev-db.mjs create-db facilityflow",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:demo": "node prisma/seed-demo.mjs",
    "db:cleanup:part2": "node prisma/cleanup-part2.mjs",
    "db:backup:check": "powershell -ExecutionPolicy Bypass -File scripts/backup-restore-check.ps1",
    "db:reset": "node scripts/dev-db.mjs reset"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/client": "5.15.0",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "multer": "^2.3.0",
    "nodemailer": "^9.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "oxlint": "^1.58.0",
    "pg": "^8.23.0",
    "prettier": "^3.4.2",
    "prisma": "5.15.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  },
  "allowScripts": {
    "prisma@5.15.0": true,
    "@prisma/engines@5.15.0": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "bcrypt@6.0.0": true,
    "@prisma/client@5.15.0": true
  }
}
